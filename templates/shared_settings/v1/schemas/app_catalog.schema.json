{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AllApp App Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apps"],
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_id", "name", "description", "url", "active", "order", "target_apps"],
        "properties": {
          "app_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "active": { "type": "boolean" },
          "order": { "type": "integer" },
          "target_apps": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
